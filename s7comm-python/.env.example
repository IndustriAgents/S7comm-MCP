# Settings for the S7comm MCP server. Copy this file to .env in this directory
# (s7comm-python/.env); in a source checkout the server finds it there. For an
# installed server, or a file elsewhere, pass it with --env-file /path/to/file.
# Variables set by the MCP client's "env" block, or in the shell, take
# precedence over the file. Comments must be on their own line.

# PLC address. 102 is the S7 port of a real PLC; the mock PLC listens on 1102.
S7_HOST=127.0.0.1
S7_PORT=1102

# S7-300: rack 0, slot 2. S7-1200/1500: rack 0, slot 1 (some setups use 0).
# S7-400: the CPU's rack and slot from the hardware configuration.
S7_RACK=0
S7_SLOT=2

# PG, OP or S7BASIC
S7_CONNECTION_TYPE=PG
# Seconds, for the connect, send and receive timeouts.
S7_TIMEOUT=5
# Reconnect attempts after a link error (PLC errors are reported at once).
S7_MAX_RETRIES=3
S7_RETRY_BACKOFF_BASE=0.5
S7_DEBUG=false

# Safety switches are NOT read from this file. The server is read-only unless
# S7_WRITES_ENABLED=true (write_db, write_output, write_marker,
# write_multiple_vars, write_tag), and set_cpu_state (RUN/STOP) also needs
# S7_SYSTEM_CMDS_ENABLED=true. Set them in the process environment (e.g. the
# MCP client's "env" block) or in a file passed with --env-file. A value here
# that would enable one is ignored, with a warning on stderr.

# Optional JSON tag map. Use an absolute path: a relative one resolves against
# the directory the server is started in.
# TAG_MAP_FILE=/absolute/path/to/tags.json
